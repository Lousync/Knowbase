        <mxCell id="note1" value="① 独立无边框 BrowserWindow：无标题栏、不进任务栏，仅表头可拖动；视觉与主窗口一致（同 CSS 变量主题）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#f0d9a8;align=left;spacingLeft=8;fontSize=10;fontColor=#6b5a2e;" vertex="1" parent="1">
          <mxGeometry x="1280" y="60" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="② 默认贴边吸附：主窗口移动/缩放实时跟随；拖离自动解除吸附，双击表头回吸附" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#f0d9a8;align=left;spacingLeft=8;fontSize=10;fontColor=#6b5a2e;" vertex="1" parent="1">
          <mxGeometry x="1280" y="124" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="note3" value="③ 位置/大小/吸附/显示状态持久化 settings.json；越界自动 clamp 回工作区（多显示器安全）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#f0d9a8;align=left;spacingLeft=8;fontSize=10;fontColor=#6b5a2e;" vertex="1" parent="1">
          <mxGeometry x="1280" y="188" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="note4" value="④ 生命周期随主窗口；启动不自动打开，手动唤起（TitleBar 按钮 / Ctrl+Alt+S）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#f0d9a8;align=left;spacingLeft=8;fontSize=10;fontColor=#6b5a2e;" vertex="1" parent="1">
          <mxGeometry x="1280" y="252" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="note5" value="⑤ 复用渲染 bundle（#/day-panel 路由）+ 现有 schedule/habit IPC；跨窗口同步走 data:notify 主进程广播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#f0d9a8;align=left;spacingLeft=8;fontSize=10;fontColor=#6b5a2e;" vertex="1" parent="1">
          <mxGeometry x="1280" y="316" width="330" height="56" as="geometry" />
        </mxCell>
        <mxCell id="note6" value="⑥ 入口按钮：TitleBar 右侧（锁屏/置顶左侧），复用 WinBtn 风格、激活高亮、tooltip 提示快捷键——按钮位置与小窗弹出方向（右侧）心智一致，不加悬浮球" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#f0d9a8;align=left;spacingLeft=8;fontSize=10;fontColor=#6b5a2e;" vertex="1" parent="1">
          <mxGeometry x="1280" y="380" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note7" value="⑦ 内容增强：逾期任务置顶红分组、子任务点击展开一级、快速添加轻量时间解析（解析失败降级=今天）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7e6;strokeColor=#f0d9a8;align=left;spacingLeft=8;fontSize=10;fontColor=#6b5a2e;" vertex="1" parent="1">
