  <diagram id="kb-plan" name="6-落地分期">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c6t" value="落地分期（每期可独立合入、可独立回滚 · 前一期不通过不进入下一期）" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="40" y="22" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="c6p0h" value="P0 · 抽派生层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9ebef;strokeColor=#d5d8de;fontSize=12;fontStyle=1;fontColor=#5b6470;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c6p0" value="· 把 sortCats / rootCats / 类型判定 / 分组 抽到 useKnowledgeViewModel&lt;br&gt;· NotebookList 改为消费 hook&lt;br&gt;· 零 UI 变化&lt;br&gt;&lt;br&gt;验收：树形展开、排序切换、空间沉浸、搜索定位 全量回归通过" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=10;fontColor=#444441;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="40" y="106" width="230" height="260" as="geometry" />
        </mxCell>

        <mxCell id="c6p1h" value="P1 · 模式开关 + 骨架" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2ebfa;strokeColor=#b9cfe8;fontSize=12;fontStyle=1;fontColor=#185FA5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="70" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c6p1" value="· settings.knowledgeViewMode 落地（默认 explorer）&lt;br&gt;· 模式切换抬到主体卡片顶栏&lt;br&gt;· ShelfView 骨架：书柜 + 一层隔板 + 静态书脊&lt;br&gt;· L1/L2 让位，书柜占满中区宽度&lt;br&gt;· 选中三元组双向同步（切模式不丢位置）&lt;br&gt;&lt;br&gt;验收：切换后选中项在另一模式中等价高亮" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=10;fontColor=#444441;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="290" y="106" width="230" height="260" as="geometry" />
        </mxCell>

        <mxCell id="c6p2h" value="P2 · 交互对齐（关键期）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2ebfa;strokeColor=#b9cfe8;fontSize=12;fontStyle=1;fontColor=#185FA5;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c6p2" value="· useContextMenuItems 数据化，两 View 共用&lt;br&gt;· useDragDrop：书脊/档案盒/散页/插入指示器四类落点&lt;br&gt;· useDeleteFx 吞噬动画接到书脊与纸页&lt;br&gt;· 内联新建（书柜空槽 / 散页 ＋）&lt;br&gt;· 收藏展示格、书签带定位、抽出抽屉&lt;br&gt;&lt;br&gt;验收：映射表 6 行 × 交互 4 项 逐格走查无缺" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=10;fontColor=#444441;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="540" y="106" width="230" height="260" as="geometry" />
        </mxCell>

        <mxCell id="c6p3h" value="P3 · 视觉打磨" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faeeda;strokeColor=#efcfa0;fontSize=12;fontStyle=1;fontColor=#854f0b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="70" width="230" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c6p3" value="· 书脊烫金书名 / 压凹 / 顶部装饰线&lt;br&gt;· 抽出动画（书 → 抽屉，缓动 240ms）&lt;br&gt;· 换柜横向滑入、隔板木纹、柜脚阴影&lt;br&gt;· 散页随机倾角（由 id 哈希，稳定不抖）&lt;br&gt;· light / dark 双主题变量补齐&lt;br&gt;&lt;br&gt;验收：两主题下对比度 ≥ 4.5:1，无位图资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=10;fontColor=#444441;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="790" y="106" width="230" height="260" as="geometry" />
        </mxCell>

        <mxCell id="c6p4h" value="P4 · 密度 / 键盘 / 性能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faeeda;strokeColor=#efcfa0;fontSize=12;fontStyle=1;fontColor=#854f0b;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="70" width="220" height="36" as="geometry" />
        </mxCell>
        <mxCell id="c6p4" value="· 三档书柜密度（紧凑/标准/宽松）&lt;br&gt;· 右区展开时书柜自动重排（不变窄就挤）&lt;br&gt;· 方向键网格导航 + 焦点环&lt;br&gt;· content-visibility 窗口化，500+ 书脊不卡&lt;br&gt;· 快捷键 Ctrl+Shift+M 与设置项&lt;br&gt;&lt;br&gt;验收：500 节点下滚动 &gt; 55fps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#dfe2e8;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=10;fontColor=#444441;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="1040" y="106" width="220" height="260" as="geometry" />
        </mxCell>

        <mxCell id="c6p0e" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#888780;strokeWidth=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6p0" target="c6p1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6p1e" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#888780;strokeWidth=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6p1" target="c6p2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6p2e" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#888780;strokeWidth=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6p2" target="c6p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c6p3e" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#888780;strokeWidth=1;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6p3" target="c6p4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="c6riskh" value="风险与对策" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2C2C2A;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c6r1" value="风险：NotebookList 的拖拽依赖直接 DOM 操作（dragRef + classList 高亮），绕开 React，抽取时易漏&lt;br&gt;对策：P0 只抽纯计算，拖拽留到 P2 用 useDragDrop 重写；新实现只在 ShelfView 使用，Explorer 原样不动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#f7c1c1;align=left;spacingLeft=12;verticalAlign=middle;fontSize=10;fontColor=#791F1F;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="40" y="428" width="600" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c6r2" value="风险：书柜是二维布局，「上/下一项」不再线性，与 sortOrder 上移/下移语义打架&lt;br&gt;对策：排序仍以 sortOrder 为准，视觉顺序 = 层序 + 层内序；方向键按视觉序走，写入时翻译回 sortOrder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#f7c1c1;align=left;spacingLeft=12;verticalAlign=middle;fontSize=10;fontColor=#791F1F;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="660" y="428" width="600" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c6r3" value="风险：空间沉浸、章节下钻、大纲切换已用多个布尔量堆出隐式状态机，再加模式维度会爆炸&lt;br&gt;对策：模式是正交于「显示态」的顶层维度；显示态收拢为 viewState: 'tree' | 'chapter' | 'outline' 单一枚举" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#f7c1c1;align=left;spacingLeft=12;verticalAlign=middle;fontSize=10;fontColor=#791F1F;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="40" y="514" width="600" height="72" as="geometry" />
        </mxCell>
        <mxCell id="c6r4" value="风险：右区（DayPanel / AI 助手）展开时会挤压中间卡片，书架重排可能闪动&lt;br&gt;对策：书架按容器宽度断点重排（&lt;640 单列 / &lt;960 两层 / 其余三层），用 ResizeObserver + 防抖，不用窗口事件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fcebeb;strokeColor=#f7c1c1;align=left;spacingLeft=12;verticalAlign=middle;fontSize=10;fontColor=#791F1F;lineHeight=1.6;" vertex="1" parent="1">
          <mxGeometry x="660" y="514" width="600" height="72" as="geometry" />
        </mxCell>

        <mxCell id="c6open" value="待你拍板的四个决策点（我已在原型里按倾向方案绘制）&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5F5E5A&quot;&gt;A. 章节 Chapter 在书架上做「书签带」还是「书中夹页」？　→ 原型按书签带&lt;br&gt;B. 单击书是「右侧抽出抽屉（保留书架场景）」还是「整个中区替换为书内视图（层级更清晰）」？　→ 原型按抽出抽屉&lt;br&gt;C. 书架模式下编辑器如何出现：中区整块切换到编辑器态 / 抽屉内直接打开 / 新开右侧子面板？　→ 原型按中区整块切换（对现有 PageTabBar 改动最小）&lt;br&gt;D. 书柜是否允许「空间列表」层（先看一排书柜再进某个柜），还是始终只显示当前空间一个柜？　→ 原型按始终单柜 + 顶栏面包屑返回空间列表&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeedfe;strokeColor=#cecbf6;align=left;spacingLeft=14;verticalAlign=middle;fontSize=12;fontColor=#534AB7;lineHeight=1.8;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1220" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
